{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "backup:firestore": "npx --yes tsx scripts/backup-firestore.ts",
    "migrate:firestore": "npx --yes tsx scripts/migrate-firestore.ts",
    "migrate:firestore:apply": "npx --yes tsx scripts/migrate-firestore.ts --apply",
    "emulador": "npx --yes firebase-tools@latest emulators:start --only firestore --project demo-family-tasks",
    "verificar:caminho-quente": "NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8390 NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-family-tasks npx --yes tsx scripts/verificar-caminho-quente.ts",
    "semear:demo": "NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8390 NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-family-tasks NEXT_PUBLIC_FAMILY_ID=demo_painel npx --yes tsx scripts/semear-demo.ts",
    "verificar:toque": "node scripts/verificar-toque.mjs",
    "dev:emulador": "NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8390 NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-family-tasks NEXT_PUBLIC_FAMILY_ID=demo_painel next dev -p 11450"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.543.0",
    "next": "15.1.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
